<%- include('./partials/header.ejs') %>
    <div class="px-20 py-10 max-[940px]:px-8 max-[820px]:px-4 max-[400px]:p-3">
        <h1 class="text-3xl mb-4 max-[400px]:text-xl max-[400px]:mb-2 max-[400px]:mt-2">Hey, <span class="capitalize">
                <%= user.name %>
            </span> 👋🏻 </h1>
        <h3 class="opacity-50 mb-10 max-[400px]:text-sm">Showing all hisaabs, till now.</h3>
        <div class="">
            <form class="flex mb-10 gap-5 max-[650px]:flex-col max-[650px]:gap-3" action="/profile" method="get">
                <div class="flex gap-5 max-[650px]:gap-2">
                    <div
                        class="px-4 py-2 flex items-center gap-4 font-medium text-sm text-zinc-500 bg-zinc-200 rounded-md max-[650px]:hidden">
                        Filters <i class="ri-sound-module-fill "></i></div>
                    <div id="bydate"
                        class="cursor-pointer px-4 py-2 flex items-center gap-4 font-medium text-sm text-zinc-500 bg-zinc-200 rounded-md max-[650px]:px-3 max-[650px]:py-[9px] max-[650px]:gap-1 max-[650px]:text-xs max-[650px]:bg-slate-700 max-[650px]:text-white max-[650px]:rounded max-[400px]:text-[10px] max-[400px]:py-[5px] max-[400px]:px-2 max-[400px]:rounded-sm">
                        By Date <i class="ri-calendar-line"></i></div>
                    <div class="hidden dates flex gap-5 items-center max-[650px]:gap-1 max-[400px]:gap-[2px]">
                        <input
                            class="bg-zinc-200 uppercase text-sm px-4 py-2 rounded-md max-[650px]:text-xs max-[650px]:bg-slate-300 max-[400px]:text-[10px] max-[400px]:px-2 max-[400px]:py-1 max-[400px]:rounded-sm"
                            name="startDate" type="date">
                        <input
                            class="bg-zinc-200 uppercase text-sm px-4 py-2 rounded-md max-[650px]:text-xs max-[650px]:bg-slate-300 max-[400px]:text-[10px] max-[400px]:px-2 max-[400px]:py-1 max-[400px]:rounded-sm"
                            name="endDate" type="date">
                    </div>
                    <select class="outline-none max-[650px]:text-sm max-[400px]:text-xs" name="byDate" id="newold">
                        <option class="max-[650px]:text-sm max-[400px]:text-xs" value="-1">Newest
                            First</option>
                        <option class="max-[650px]:text-sm max-[400px]:text-xs" value="1">Oldest
                            First</option>
                    </select>
                </div>
                <input
                    class="w-max cursor-pointer px-6 py-2 bg-blue-500 text-white rounded max-[650px]:px-5 max-[650px]:py-2 max-[650px]:gap-1 max-[650px]:text-sm max-[650px]:font-medium max-[650px]:rounded max-[400px]:px-4 max-[400px]:py-[6px] max-[400px]:rounded-sm max-[400px]:tracking-wide"
                    type="submit" value="Filter">
            </form>
        </div>
        <div
            class="w-full h-[380px] flex gap-10 items-start flex-wrap overflow-y-auto rounded-md max-[850px]:gap-4 max-[400px]:h-[460px]">
            <% if(user.hisab.length> 0) { %>
                <% user.hisab.forEach(hisab=> { %>
                    <div
                        class="bg-zinc-200 p-3 px-5 rounded-md overflow-auto max-[780px]:py-3 max-[780px]:px-[14px] max-[650px]:p-3">
                        <div
                            class="flex gap-10 items-center max-[780px]:gap-6 max-[650px]:flex-col max-[650px]:gap-1 max-[400px]:flex-row max-[400px]:justify-center">
                            <div class="flex justify-center gap-2 items-start">
                                <% if(hisab.encrypted) { %>
                                    <div
                                        class="px-3 py-2 rounded-md flex gap-2 items-center bg-blue-500 text-white max-[780px]:px-2 max-[780px]:py-1 max-[780px]:gap-1">
                                        <i
                                            class="text-xs ri-lock-2-line mb-[1px] max-[780px]:text-[11px] max-[780px]:font-semibold"></i>
                                        <h3 class="text-sm max-[780px]:text-xs max-[780px]:font-semibold">Encrypted</h3>
                                    </div>
                                    <% } else { %>
                                        <div
                                            class="px-3 py-2 rounded-md flex gap-2 items-center bg-teal-600 text-white max-[780px]:px-2 max-[780px]:py-1 max-[780px]:gap-1">
                                            <i
                                                class="text-xs ri-check-line min-[780px]:mb-[1px] font-semibold max-[780px]:text-[11px]"></i>
                                            <h3 class="text-sm max-[780px]:text-xs max-[780px]:font-semibold">Available
                                            </h3>
                                        </div>
                                        <% } %>
                                            <% if(!hisab.shareable) { %>
                                                <div
                                                    class="px-3 py-2 rounded-md bg-zinc-300/70 flex items-center justify-center max-[780px]:px-[7px] max-[780px]:py-[2px]">
                                                    <i
                                                        class="text-sm ri-eye-off-line font-semibold max-[780px]:text-[11px]"></i>
                                                </div>
                                                <% } %>
                            </div>
                            <h3
                                class="text-xs text-zinc-400 max-[650px]:mt-3 max-[650px]:ml-1 max-[400px]:mt-0 max-[400px]:text-[10px]">
                                Created
                                on <%= hisab.createdAt.toLocaleDateString() %>
                            </h3>
                        </div>
                        <div class="mt-3 max-[650px]:ml-1">
                            <h3 class="font-medium text-lg capitalize max-[780px]:text-base">
                                <%= hisab.title %>
                            </h3>
                            <a class="text-zinc-400 text-sm max-[780px]:text-[13px] max-[780px]:text-zinc-500"
                                href="/profile/hisab/<%= hisab._id %>">View
                                Hisab</a>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <h1 class="text-zinc-400 max-[600px]:text-sm">You haven't created any hisab yet.</h1>
                            <% } %>
        </div>
    </div>
    <script>
        document.querySelector("#bydate")
            .addEventListener("click", function (event) {
                if (document.querySelector(".dates").classList.contains("hidden")) {
                    document.querySelector(".dates").classList.remove("hidden");
                    document.querySelector("#newold").classList.add("hidden");
                }
                else {
                    document.querySelector(".dates").classList.add("hidden");
                    document.querySelector("#newold").classList.remove("hidden")
                }
            })

        document.querySelector(".home-button").classList.add("hidden");
    </script>
    <%- include('./partials/footer.ejs') %>